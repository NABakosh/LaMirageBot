# La Mirage WhatsApp Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== VERTEX AI CONFIGURATION ====================
# Google Cloud Project ID for Vertex AI
VERTEX_PROJECT_ID=your-project-id

# Vertex AI region (us-central1 recommended)
VERTEX_LOCATION=us-central1

# Path to Vertex AI service account key file
VERTEX_KEY_FILE=./vertex_key.json

# ==================== GOOGLE CALENDAR CONFIGURATION ====================
# Path to Google Calendar service account credentials
GOOGLE_CALENDAR_CREDENTIALS=./credentials.json

# Google Calendar ID (use 'primary' for main calendar or specific calendar ID)
CALENDAR_ID=primary

# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lamiragebeauty

# ==================== ADMIN CONFIGURATION ====================
# Comma-separated list of admin WhatsApp numbers (without + or spaces)
# Example: 77064240050,77051234567
ADMIN_WHITELIST=77064240050

# ==================== SALON INFORMATION ====================
# Salon name
SALON_NAME=La Mirage Beauty

# Salon physical address
SALON_ADDRESS=Almaty, Kazakhstan

# Instagram profile link
INSTAGRAM_LINK=https://instagram.com/lamirage

# Working hours
WORKING_HOURS=Ежедневно с 10:00 до 21:00

# ==================== WHATSAPP INTEGRATION ====================
# Choose integration method: twilio, business_api, or web
WHATSAPP_METHOD=twilio

# --- TWILIO CONFIGURATION (if using Twilio) ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- WHATSAPP BUSINESS API CONFIGURATION (if using Business API) ---
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ==================== OPTIONAL CONFIGURATION ====================
# Environment (development or production)
NODE_ENV=development

# Webhook server configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000

# Session timeout in minutes (default: 30)
SESSION_TIMEOUT_MINUTES=30

# Reminder time before appointment in minutes (default: 60)
REMINDER_MINUTES_BEFORE=60
